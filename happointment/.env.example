# --- Core ---
SECRET_KEY=change-this-to-a-random-string
# Leave DATABASE_URL unset to use local SQLite at instance/app.db (auto-created).
# For Postgres (e.g. Render/Railway managed DB), set:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Default admin (auto-created on first run if no admin exists) ---
ADMIN_EMAIL=admin@clinic.local
ADMIN_PASSWORD=admin123

# --- LLM (optional — falls back to a rule-based summarizer if unset) ---
# Works with Groq's free tier (https://console.groq.com), OpenAI, or any
# OpenAI-compatible endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=8

# --- Email (optional — simulated/logged to console if unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@clinic.local
EMAIL_MAX_RETRIES=3

# --- Google Calendar (optional — skipped gracefully if not connected) ---
GOOGLE_CLIENT_SECRETS_FILE=client_secret.json
GOOGLE_TOKEN_FILE=instance/google_token.json
GOOGLE_REDIRECT_URI=http://localhost:5000/admin/google/callback

# --- Background jobs ---
SCHEDULER_INTERVAL_SECONDS=60
ENABLE_SCHEDULER=1

# --- Timezone (used for Google Calendar events) ---
CLINIC_TIMEZONE=Asia/Kolkata
